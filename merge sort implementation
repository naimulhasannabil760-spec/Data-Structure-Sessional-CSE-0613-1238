#include<bits/stdc++.h>
using namespace std;

void merge(vector<int>& A, int l, int mid, int h)
{
    int i = l;
    int j = mid + 1;
    int k = l;
    vector<int> temp(A.size());
    while (i <= mid && j <= h)
    {
        if (A[i] <= A[j])
        {
            temp[k] = A[i];
            i++;
        }
        else
        {
            temp[k] = A[j];
            j++;
        }
        k++;
    }

    while (i <= mid)
    {
        temp[k] = A[i];
        i++;
        k++;
    }

    while (j <= h)
    {
        temp[k] = A[j];
        j++;
        k++;
    }

    for (k = l; k <= h; k++)
    {
        A[k] = temp[k];
    }
}

void mergeSort(vector<int>& A, int l, int h)
{
    if (l < h)
    {
        int mid = (l + h) / 2;

        mergeSort(A, l, mid);
        mergeSort(A, mid + 1, h);

        merge(A, l, mid, h);
    }
}

int main()
{
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    vector<int> A(n);

    cout << "Enter the elements: "<<endl;
    for (int i = 0; i < n; i++)
    {
        cin >> A[i];
    }

    mergeSort(A, 0, n - 1);

    cout << "Sorted array: "<<endl;
    for (int i = 0; i < n; i++)
    {
        cout << A[i] << " ";
    }

    return 0;
}
